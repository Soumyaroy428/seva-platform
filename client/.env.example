# Backend API Target (Proxied via Next.js rewrites)
BACKEND_URL=http://localhost:5000

# Direct MongoDB URI (Optional for direct SSR routes)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/seva?retryWrites=true&w=majority

# Sovereign UPI Gateway Public Checkout Target
NEXT_PUBLIC_YOUPI_CHECKOUT_URL=http://localhost:7000
NEXT_PUBLIC_YOUPI_API_URL=http://localhost:6100

# CMS Administrator Credentials (Env Controlled)
NEXT_PUBLIC_CMS_ADMIN_EMAIL=admin@seva.org
NEXT_PUBLIC_CMS_ADMIN_PASSWORD=Admin@123456

# CMS Field Volunteer Credentials (4 Env Controlled Personnel Slots)
NEXT_PUBLIC_CMS_VOLUNTEER_1_EMAIL=volunteer1@seva.org
NEXT_PUBLIC_CMS_VOLUNTEER_1_PASSWORD=Vol@2026_Slot1
NEXT_PUBLIC_CMS_VOLUNTEER_2_EMAIL=volunteer2@seva.org
NEXT_PUBLIC_CMS_VOLUNTEER_2_PASSWORD=Vol@2026_Slot2
NEXT_PUBLIC_CMS_VOLUNTEER_3_EMAIL=volunteer3@seva.org
NEXT_PUBLIC_CMS_VOLUNTEER_3_PASSWORD=Vol@2026_Slot3
NEXT_PUBLIC_CMS_VOLUNTEER_4_EMAIL=volunteer4@seva.org
NEXT_PUBLIC_CMS_VOLUNTEER_4_PASSWORD=Vol@2026_Slot4

# Role Capacity Governance Quotas (CMS & Env Controlled)
NEXT_PUBLIC_MAX_ADMINS=1
NEXT_PUBLIC_MAX_VOLUNTEERS=4
