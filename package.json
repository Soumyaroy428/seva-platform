{
  "name": "seva-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "SEVA — Full-Phase Donation, Food Distribution & Community Support Platform (Client & Server)",
  "scripts": {
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "build:client": "cd client && npm run build",
